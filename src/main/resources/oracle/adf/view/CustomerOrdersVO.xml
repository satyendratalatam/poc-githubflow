  Oracle ADF View Object: CustomerOrdersVO
  Base definition — do NOT modify directly.
  All feature additions must be gated with a FEATURE_FLAG block (see below).

  FEATURE FLAG CONVENTION:
    Enabled  feature → uncomment the block, set enabled="true"
    Disabled feature → keep block commented out OR set enabled="false"

  Active flags in this file:
    FF_LOYALTY_TIER          = false   (loyalty tier column — in development)
    FF_BULK_DISCOUNT         = false   (bulk discount calculation — planned)
    FF_REALTIME_INVENTORY    = false   (live inventory join — performance review pending)
    FF_ORDER_ANALYTICS       = false   (analytics sub-query — data team sign-off needed)
-->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="CustomerOrdersVO"
  Version="12.1.3.0.0"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="false"
  PageIterMode="Full"
  UseGlueCode="false"
  ComponentClass="oracle.jbo.server.ViewObjectImpl"
  RowClass="model.CustomerOrdersVORowImpl"
  RowImplName="model.CustomerOrdersVORowImpl"
  DefClass="model.CustomerOrdersVODefImpl">

  <!-- ═══════════════════════════════════════════════════════════════
       BASE SQL QUERY
       Core join: customers → orders → order_lines → products
       Changes to this block require DBA review + migration ticket.
       ═══════════════════════════════════════════════════════════════ -->
  <SQLQuery><![CDATA[
    SELECT
      c.customer_id,
      c.first_name,
      c.last_name,
      c.email,
      c.customer_segment,
      o.order_id,
      o.order_date,
      o.status          AS order_status,
      o.total_amount,
      o.currency_code,
      ol.line_id,
      ol.product_id,
      ol.quantity,
      ol.unit_price,
      ol.line_total,
      p.product_name,
      p.category_code

      /* ── FF_LOYALTY_TIER ─────────────────────────────────────────
         Feature: Show customer loyalty tier alongside each order.
         Status : DISABLED — loyalty_tiers table not yet promoted to PROD.
         Branch : feature/loyalty-tier-display
         Ticket : ORD-412
         ─────────────────────────────────────────────────────────────
      , lt.tier_name    AS loyalty_tier
      , lt.discount_pct AS loyalty_discount
         ─────────────────────────────────────────────────── END FF ── */

      /* ── FF_BULK_DISCOUNT ────────────────────────────────────────
         Feature: Compute bulk-discount at query level for reporting.
         Status : DISABLED — business rules still under review.
         Branch : feature/bulk-discount-engine
         Ticket : ORD-489
         ─────────────────────────────────────────────────────────────
      , CASE
          WHEN ol.quantity >= 100 THEN ol.line_total * 0.85
          WHEN ol.quantity >=  50 THEN ol.line_total * 0.90
          WHEN ol.quantity >=  10 THEN ol.line_total * 0.95
          ELSE ol.line_total
        END              AS discounted_total
         ─────────────────────────────────────────────────── END FF ── */

      /* ── FF_ORDER_ANALYTICS ──────────────────────────────────────
         Feature: Inline analytics — running total and rank per customer.
         Status : DISABLED — data team sign-off on window function cost needed.
         Branch : feature/order-analytics-view
         Ticket : ORD-521
         ─────────────────────────────────────────────────────────────
      , SUM(o.total_amount)
          OVER (PARTITION BY c.customer_id ORDER BY o.order_date)
                         AS running_total
      , RANK()
          OVER (PARTITION BY c.customer_id ORDER BY o.total_amount DESC)
                         AS order_rank
         ─────────────────────────────────────────────────── END FF ── */

    FROM   customers        c
    JOIN   orders           o  ON o.customer_id  = c.customer_id
    JOIN   order_lines      ol ON ol.order_id    = o.order_id
    JOIN   products         p  ON p.product_id   = ol.product_id

    /* ── FF_LOYALTY_TIER (JOIN) ──────────────────────────────────
       Must be uncommented together with the SELECT columns above.
       ─────────────────────────────────────────────────────────────
    LEFT JOIN loyalty_tiers lt ON lt.customer_id = c.customer_id
       ─────────────────────────────────────────────────── END FF ── */

    /* ── FF_REALTIME_INVENTORY (JOIN) ────────────────────────────
       Feature: Live inventory count per product on each order line.
       Status : DISABLED — full-table join flagged in perf review.
       Branch : feature/realtime-inventory-join
       Ticket : ORD-503
       ───────────────────────────────────────────────────────────
    JOIN inventory_snapshots inv
         ON  inv.product_id   = ol.product_id
         AND inv.snapshot_ts  = (
               SELECT MAX(snapshot_ts)
               FROM   inventory_snapshots
               WHERE  product_id = ol.product_id
             )
       ─────────────────────────────────────────────────── END FF ── */

    WHERE  o.status != 'CANCELLED'
    ORDER  BY c.customer_id, o.order_date DESC
  ]]></SQLQuery>

